# PostgreSQL (TypeORM)
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/gestify"

# Porta da API
PORT=3000

# URL do frontend (CORS em produção)
FRONTEND_URL="http://localhost:5173"

# Chave Gemini — marketing com IA
# https://aistudio.google.com/apikey
GEMINI_API_KEY="sua-chave-gemini-aqui"

# Logística — estimativa de tempo de entrega (Google Maps Distance Matrix)
# https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=""

# Endereço completo da loja (origem das rotas de delivery)
STORE_ORIGIN_ADDRESS="Rua Exemplo, 100, Centro, Palmas, TO, 77001-000, Brasil"

# Segredo para assinatura de tokens JWT (Gerar um valor seguro e único em produção)
JWT_SECRET="um-segredo-longo-e-seguro-aqui"

# Credenciais do administrador padrão inicial (usadas se a tabela de usuários estiver vazia no bootstrap)
# ADMIN_USERNAME deve ter entre 4 e 8 dígitos numéricos
ADMIN_USERNAME="1164"
ADMIN_PASSWORD="sua-senha-admin-segura-aqui"

# Configurações de SSL/TLS do Banco de Dados
# DB_SSL=true # Define se o uso de SSL deve ser forçado
# DB_SSL_REJECT_UNAUTHORIZED=true # Define se deve validar o certificado (padrão é true em produção e Supabase)
# DB_SSL_CA="conteudo_do_certificado_ca" # Permite especificar o certificado CA se necessário
